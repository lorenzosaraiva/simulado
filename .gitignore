# Installed dependencies and package manager caches
node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/

# Packaged releases and generated test/research output
/dist/
/artifacts/
/coverage/
/test-results/
/playwright-report/

# Build scratch files; these icons are inputs to the Windows build
/build/*
!/build/icon.svg
!/build/icon.png
!/build/icon.ico

# Local configuration and signing credentials
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.jks
*.keystore
*.p12
*.pfx

# Logs and tool caches
*.log
*.tsbuildinfo
.eslintcache
.cache/
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor and operating system files
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
~$*
